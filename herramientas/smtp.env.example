# Correo (Gmail ahora; IONOS cuando tengáis dominio)
# En Gmail: cuenta Google → Seguridad → Contraseñas de aplicaciones
# Copia este archivo a .env en el VPS o añade estas variables a /opt/reforma-gobierno/.env
# NUNCA subas el .env real a GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=tu-cuenta@gmail.com

# URL pública para los enlaces de "olvidé mi contraseña"
# (túnel Cloudflare o dominio futuro)
PUBLIC_URL=https://TU-ENLACE.trycloudflare.com

# Ya existentes en el VPS (generar valores propios, no reutilizar ejemplos):
# SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
# MODO_VPS=1
