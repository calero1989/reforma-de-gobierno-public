# =============================================================================
# SOLO PARA CUANDO TENGAS DOMINIO — no uses este archivo todavia
# =============================================================================
#
# Mientras no tengas nombre/dominio, el VPS usa túnel RÁPIDO (trycloudflare.com).
# Cuando estés listo:
#   1. Lee herramientas/CUANDO_TENGAS_DOMINIO.md
#   2. Crea el túnel en Cloudflare y copia el token
#   3. Ejecuta: .\herramientas\activar-dominio.ps1
#      (o copia este archivo a .tunnel.env en la raíz del proyecto y rellena)
#
# El archivo real .tunnel.env NO se sube a git (ver .gitignore).

TUNNEL_TOKEN=eyJhIjoi...
PUBLIC_HOSTNAME=app.TUDOMINIO.com
